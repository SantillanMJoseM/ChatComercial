generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  name          String
  emailVerified Boolean   @default(false)
  image         String?
  isActive      Boolean   @default(true)
  isSuperAdmin  Boolean   @default(false)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime? @db.Timestamptz(6)

  roles         UserRole[]
  teamMembers   TeamMember[]
  auditLogs     AuditLog[] @relation("AuditActor")
  sessions      Session[]
  accounts      Account[]

  ownedClients  Client[]        @relation("ClientOwner")
  segmentsCreated Segment[]     @relation("SegmentCreator")
  segmentExecutions SegmentExecution[] @relation("SegmentExecutionActor")
  whatsappGroupsCreated WhatsAppGroup[] @relation("WhatsAppGroupCreator")
  operatorProfile OperatorProfile?
  supervisedTeams TeamSupervisor[]
  clientNotes   ClientNote[]
  interactions  ClientInteraction[] @relation("InteractionActor")
  ragFeedbacks  AIRagFeedback[]
  convAssignments ConversationReference[] @relation("ConvAssignee")
  assignFrom    AssignmentHistory[] @relation("AssignFromUser")
  assignTo      AssignmentHistory[] @relation("AssignToUser")
  assignActor   AssignmentHistory[] @relation("AssignActor")
  aiExecutions  AIExecution[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeCollections KnowledgeCollection[]
  skillVersions     SkillVersion[]
  skillExecutions   SkillExecution[]

  @@index([email])
  @@index([isActive])
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  key         String       @unique
  name        String
  description String?
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)

  users       UserRole[]
  permissions RolePermission[]

  @@index([key])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  module      String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  roles       RolePermission[]

  @@index([module])
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Team {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  chatwootTeamId Int?      @unique
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime? @db.Timestamptz(6)

  members        TeamMember[]
  supervisors    TeamSupervisor[]
  clients        Client[]
  conversationRefs ConversationReference[]
  assignFrom     AssignmentHistory[] @relation("AssignFromTeam")
  assignTo       AssignmentHistory[] @relation("AssignToTeam")
  chatwootTeamLinks ChatwootTeamLink[]

  @@index([name])
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @db.Uuid
  userId    String   @db.Uuid
  role      String   @default("member")
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @db.Uuid
  action      String
  resource    String
  resourceId  String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  isSecret  Boolean  @default(false)
  updatedBy String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([key])
}

model Integration {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  type        String
  baseUrl     String?
  credentials Json?
  isActive    Boolean  @default(false)
  config      Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  events IntegrationEvent[]

  @@index([key])
  @@index([type])
}

model IntegrationEvent {
  id            String   @id @default(uuid()) @db.Uuid
  integrationId String   @db.Uuid
  eventType     String
  payload       Json
  status        String   @default("pending")
  attempts      Int      @default(0)
  lastError     String?
  processedAt   DateTime? @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([status])
  @@index([createdAt])
}


model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId])
}

model Verification {
  id         String    @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime  @db.Timestamptz(6)
  createdAt  DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime? @updatedAt @db.Timestamptz(6)

  @@index([identifier])
}


model AIRagFeedback {
  id           String   @id @default(uuid()) @db.Uuid
  executionId  String   @db.Uuid
  userId       String?  @db.Uuid
  rating       String
  comment      String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  execution    AIExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([executionId])
  @@index([createdAt])
}

model OutboxMessage {
  id          String   @id @default(uuid()) @db.Uuid
  aggregate   String
  eventType   String
  payload     Json
  status      String   @default("pending")
  attempts    Int      @default(0)
  lastError   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  processedAt DateTime? @db.Timestamptz(6)

  @@index([status])
  @@index([createdAt])
}

model Client {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  legalName        String?
  taxId            String?   @unique
  phone            String?
  email            String?
  address          String?
  notes            String?
  tags             String[]  @default([])
  origin           String?
  status           String    @default("active")
  isActive         Boolean   @default(true)
  ownerId          String?   @db.Uuid
  teamId           String?   @db.Uuid
  lastInteractionAt DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime? @db.Timestamptz(6)

  owner            User?     @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  team             Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  contacts         Contact[]
  identities       CustomerIdentity[]
  segmentParticipants SegmentParticipant[]
  whatsappConsents  WhatsAppConsent[]
  aiExecutions     AIExecution[]
  clientNotes     ClientNote[]
  interactions     ClientInteraction[]
  conversations    ConversationReference[]

  @@index([name])
  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([teamId])
  @@index([ownerId])
}

model Contact {
  id          String    @id @default(uuid()) @db.Uuid
  clientId    String    @db.Uuid
  firstName   String
  lastName    String?
  phones      String[]  @default([])
  whatsapp    String?
  email       String?
  jobTitle    String?
  isPrimary   Boolean   @default(false)
  preferences Json?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  client               Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  conversationRefs     ConversationReference[]
  segmentParticipants  SegmentParticipant[]
  whatsappConsents     WhatsAppConsent[]

  @@index([clientId])
  @@index([isPrimary])
}

model CustomerIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @db.Uuid
  type      String
  value     String
  verified  Boolean  @default(false)
  source    String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([type, value])
  @@index([clientId])
}

model OperatorProfile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  availability   String   @default("offline")
  workingHours   Json?
  chatwootAgentId Int?    @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeamSupervisor {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model ConversationReference {
  id                    String    @id @default(uuid()) @db.Uuid
  chatwootConversationId Int      @unique
  chatwootInboxId       Int?
  status                String    @default("open")
  priority              String?
  clientId              String?   @db.Uuid
  contactId             String?   @db.Uuid
  localAssigneeId       String?   @db.Uuid
  chatwootAssigneeId    Int?
  localTeamId           String?   @db.Uuid
  chatwootTeamId        Int?
  lastActivityAt        DateTime? @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  client                Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contact               Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  localAssignee         User?     @relation("ConvAssignee", fields: [localAssigneeId], references: [id], onDelete: SetNull)
  localTeam             Team?     @relation(fields: [localTeamId], references: [id], onDelete: SetNull)
  assignments           AssignmentHistory[]
  aiExecutions          AIExecution[]
  aiHandoffs            AIHandoff[]

  @@index([status])
  @@index([clientId])
  @@index([localAssigneeId])
  @@index([localTeamId])
}

model AssignmentHistory {
  id                     String   @id @default(uuid()) @db.Uuid
  conversationRefId      String   @db.Uuid
  fromUserId             String?  @db.Uuid
  toUserId               String?  @db.Uuid
  fromTeamId             String?  @db.Uuid
  toTeamId               String?  @db.Uuid
  fromChatwootAssigneeId Int?
  toChatwootAssigneeId   Int?
  reason                 String?
  actorId                String?  @db.Uuid
  syncStatus             String   @default("pending")
  syncError              String?
  createdAt              DateTime @default(now()) @db.Timestamptz(6)

  conversationRef        ConversationReference @relation(fields: [conversationRefId], references: [id], onDelete: Cascade)
  fromUser               User?    @relation("AssignFromUser", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser                 User?    @relation("AssignToUser", fields: [toUserId], references: [id], onDelete: SetNull)
  fromTeam               Team?    @relation("AssignFromTeam", fields: [fromTeamId], references: [id], onDelete: SetNull)
  toTeam                 Team?    @relation("AssignToTeam", fields: [toTeamId], references: [id], onDelete: SetNull)
  actor                  User?    @relation("AssignActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([conversationRefId])
  @@index([createdAt])
}

model ClientNote {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @db.Uuid
  authorId  String?  @db.Uuid
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([createdAt])
}

model ClientInteraction {
  id         String   @id @default(uuid()) @db.Uuid
  clientId   String   @db.Uuid
  type       String
  summary    String
  actorId    String?  @db.Uuid
  occurredAt DateTime @default(now()) @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actor      User?    @relation("InteractionActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([occurredAt])
}

model Segment {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  criteria    Json
  isDynamic   Boolean   @default(true)
  createdBy   String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  creator     User?     @relation("SegmentCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  participants SegmentParticipant[]
  executions  SegmentExecution[]
  whatsappGroups WhatsAppGroup[]

  @@index([name])
  @@index([isDynamic])
}

model SegmentParticipant {
  id        String   @id @default(uuid()) @db.Uuid
  segmentId String   @db.Uuid
  clientId  String?  @db.Uuid
  contactId String?  @db.Uuid
  phoneE164 String?
  snapshot  Json?
  addedAt   DateTime @default(now()) @db.Timestamptz(6)

  segment   Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  executionResults SegmentExecutionResult[]

  @@index([segmentId])
  @@index([clientId])
  @@index([contactId])
}

model SegmentExecution {
  id               String    @id @default(uuid()) @db.Uuid
  segmentId        String    @db.Uuid
  type             String
  status           String    @default("preview")
  totalParticipants Int      @default(0)
  eligibleCount    Int       @default(0)
  successCount     Int       @default(0)
  failCount        Int       @default(0)
  idempotencyKey   String?   @unique
  consentValidated Boolean   @default(false)
  snapshot         Json?
  startedAt        DateTime  @default(now()) @db.Timestamptz(6)
  finishedAt       DateTime? @db.Timestamptz(6)
  actorId          String?   @db.Uuid
  error            String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  segment          Segment   @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  actor            User?     @relation("SegmentExecutionActor", fields: [actorId], references: [id], onDelete: SetNull)
  results          SegmentExecutionResult[]

  @@index([segmentId])
  @@index([status])
  @@index([idempotencyKey])
}

model SegmentExecutionResult {
  id            String   @id @default(uuid()) @db.Uuid
  executionId   String   @db.Uuid
  participantId String?  @db.Uuid
  status        String
  externalId    String?
  error         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  execution     SegmentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  participant   SegmentParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([executionId])
  @@index([status])
}

model WhatsAppGroup {
  id          String   @id @default(uuid()) @db.Uuid
  segmentId   String?  @db.Uuid
  wahaSession String
  wahaGroupId String   @unique
  name        String
  createdBy   String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  segment     Segment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  creator     User?    @relation("WhatsAppGroupCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  members     WhatsAppGroupMember[]

  @@index([segmentId])
}

model WhatsAppGroupMember {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @db.Uuid
  phoneE164 String
  status    String   @default("added")
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  group     WhatsAppGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, phoneE164])
  @@index([groupId])
}

model ChatwootTeamLink {
  id             String   @id @default(uuid()) @db.Uuid
  localTeamId    String?  @db.Uuid
  chatwootTeamId Int      @unique
  name           String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  localTeam      Team?    @relation(fields: [localTeamId], references: [id], onDelete: SetNull)

  @@index([localTeamId])
}

model WhatsAppConsent {
  id                String    @id @default(uuid()) @db.Uuid
  contactId         String?   @db.Uuid
  clientId          String?   @db.Uuid
  phoneE164         String
  purpose           String
  channel           String    @default("whatsapp")
  status            String    @default("granted")
  capturedAt        DateTime  @default(now()) @db.Timestamptz(6)
  source            String?
  evidenceReference String?
  revokedAt         DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  contact           Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  client            Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([phoneE164, purpose, channel])
  @@index([contactId])
  @@index([clientId])
  @@index([status])
}

model AIProvider {
  id              String   @id @default(uuid()) @db.Uuid
  key             String   @unique
  name            String
  baseUrl         String
  apiKeyEncrypted String
  isActive        Boolean  @default(false)
  capabilities    Json?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
  models          AIModel[]
  assistants      AIAssistant[]
}

model AIModel {
  id             String   @id @default(uuid()) @db.Uuid
  providerKey    String
  modelId        String
  displayName    String
  capabilities   Json
  contextWindow  Int?
  maxOutputTokens Int?
  inputPrice     Decimal?  @db.Decimal(18,6)
  outputPrice    Decimal?  @db.Decimal(18,6)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  provider       AIProvider @relation(fields: [providerKey], references: [key], onDelete: Cascade)
  assistants     AIAssistant[]
  @@unique([providerKey, modelId])
}

model AIAssistant {
  id               String   @id @default(uuid()) @db.Uuid
  key              String   @unique
  name             String
  description      String?
  providerKey      String
  modelKey         String?  // references AIModel.id? use model id
  modelId          String   @db.Uuid
  systemPrompt     String
  temperature      Float?   @default(0.7)
  topP             Float?
  maxTokens        Int?
  mode             String   @default("disabled")
  humanHandoffPolicy Json?
  usageLimits      Json?
  isActive         Boolean  @default(true)
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)
  provider         AIProvider @relation(fields: [providerKey], references: [key])
  model            AIModel    @relation(fields: [modelId], references: [id])
  tools            AIAssistantTool[]
  executions       AIExecution[]
  knowledgeCollections AIAssistantKnowledge[]
}

model AITool {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  schema      Json
  requiredPermission String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  assistants  AIAssistantTool[]
  skillToolPermissions SkillToolPermission[]
}

model AIAssistantTool {
  id          String   @id @default(uuid()) @db.Uuid
  assistantId String   @db.Uuid
  toolId      String   @db.Uuid
  assistant   AIAssistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  tool        AITool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  @@unique([assistantId, toolId])
}

model AIExecution {
  id               String   @id @default(uuid()) @db.Uuid
  assistantId      String   @db.Uuid
  conversationRefId String? @db.Uuid
  clientId         String?  @db.Uuid
  userId           String?  @db.Uuid
  mode             String
  queryText        String?
  contextId        String?  @db.Uuid
  evidenceStatus   String?
  handoffReason    String?
  abstained        Boolean  @default(false)
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  estimatedCost    Decimal? @db.Decimal(18,6)
  latencyMs        Int?
  status           String
  error            String?
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  assistant        AIAssistant @relation(fields: [assistantId], references: [id])
  conversationRef  ConversationReference? @relation(fields: [conversationRefId], references: [id], onDelete: SetNull)
  client           Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  feedbacks        AIRagFeedback[]
  @@index([assistantId])
  @@index([createdAt])
}

model AIUsageRecord {
  id           String   @id @default(uuid()) @db.Uuid
  providerKey  String
  modelId      String   @db.Uuid
  assistantId  String?  @db.Uuid
  executionId  String?  @db.Uuid
  inputTokens  Int
  outputTokens Int
  cost         Decimal? @db.Decimal(18,6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  @@index([providerKey])
  @@index([createdAt])
}

model AIHandoff {
  id               String   @id @default(uuid()) @db.Uuid
  conversationRefId String  @db.Uuid
  fromAssistantId  String?  @db.Uuid
  toUserId         String?  @db.Uuid
  reason           String?
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  conversationRef  ConversationReference @relation(fields: [conversationRefId], references: [id], onDelete: Cascade)
}

model AIConfiguration {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model KnowledgeCollection {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  isPublic    Boolean   @default(false)
  createdBy   String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  creator     User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  documents   KnowledgeDocument[]
  assistantLinks AIAssistantKnowledge[]

  @@index([name])
}

model KnowledgeDocument {
  id            String    @id @default(uuid()) @db.Uuid
  collectionId  String    @db.Uuid
  name          String
  description   String?
  mimeType      String
  sizeBytes     Int
  storagePath   String
  hash          String
  status        String    @default("pending")
  currentVersionId String? @db.Uuid
  createdBy     String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime? @db.Timestamptz(6)

  collection    KnowledgeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  creator       User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  versions      KnowledgeDocumentVersion[]

  @@unique([collectionId, hash])
  @@index([collectionId])
  @@index([status])
  @@index([hash])
}

model KnowledgeDocumentVersion {
  id          String    @id @default(uuid()) @db.Uuid
  documentId  String    @db.Uuid
  version     Int
  storagePath String
  hash        String
  status      String    @default("processing")
  error       String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  publishedAt DateTime? @db.Timestamptz(6)

  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunks      KnowledgeChunk[]
  jobs        KnowledgeProcessingJob[]

  @@unique([documentId, version])
  @@index([documentId])
  @@index([status])
}

model KnowledgeChunk {
  id          String    @id @default(uuid()) @db.Uuid
  versionId   String    @db.Uuid
  chunkIndex  Int
  content     String
  tokenCount  Int?
  metadata    Json?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  version     KnowledgeDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  embeddings  KnowledgeEmbedding[]
  sourceReferences KnowledgeSourceReference[]

  @@unique([versionId, chunkIndex])
  @@index([versionId])
}

model KnowledgeEmbedding {
  id          String    @id @default(uuid()) @db.Uuid
  chunkId     String    @db.Uuid
  providerKey String
  modelId     String    @db.Uuid
  dimension   Int
  vector      Unsupported("vector")
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  chunk       KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([chunkId])
  @@index([modelId])
}

model KnowledgeProcessingJob {
  id          String    @id @default(uuid()) @db.Uuid
  versionId   String    @db.Uuid
  status      String    @default("pending")
  step        String?
  error       String?
  attempts    Int       @default(0)
  startedAt   DateTime? @db.Timestamptz(6)
  finishedAt  DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  version     KnowledgeDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@index([status])
}

model KnowledgeSourceReference {
  id            String   @id @default(uuid()) @db.Uuid
  executionId   String?  @db.Uuid
  chunkId       String   @db.Uuid
  score         Float?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  chunk         KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([chunkId])
}

model AIAssistantKnowledge {
  id            String   @id @default(uuid()) @db.Uuid
  assistantId   String   @db.Uuid
  collectionId  String   @db.Uuid
  relevanceThreshold Float? @default(0.7)
  maxChunks     Int?     @default(5)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  assistant     AIAssistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  collection    KnowledgeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([assistantId, collectionId])
  @@index([assistantId])
  @@index([collectionId])
}

model Skill {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  versions    SkillVersion[]
}

model SkillVersion {
  id          String    @id @default(uuid()) @db.Uuid
  skillId     String    @db.Uuid
  version     Int
  instructions String
  parameters  Json?
  createdBy   String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  creator     User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  executions  SkillExecution[]
  toolPermissions SkillToolPermission[]

  @@unique([skillId, version])
  @@index([skillId])
}

model SkillExecution {
  id          String    @id @default(uuid()) @db.Uuid
  skillVersionId String @db.Uuid
  userId      String?   @db.Uuid
  input       Json?
  output      Json?
  status      String    @default("completed")
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  skillVersion SkillVersion @relation(fields: [skillVersionId], references: [id], onDelete: Cascade)
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([skillVersionId])
  @@index([createdAt])
}

model SkillToolPermission {
  id             String   @id @default(uuid()) @db.Uuid
  skillVersionId String   @db.Uuid
  toolId         String   @db.Uuid
  allowed        Boolean  @default(true)

  skillVersion   SkillVersion @relation(fields: [skillVersionId], references: [id], onDelete: Cascade)
  tool           AITool       @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([skillVersionId, toolId])
}
