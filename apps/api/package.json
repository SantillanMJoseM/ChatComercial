{
  "name": "@cap/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/main.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy --schema ../../database/prisma/schema.prisma",
    "db:seed": "tsx src/seed.ts",
    "prisma:generate": "prisma generate --schema ../../database/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "@types/multer": "^2.3.0",
    "better-auth": "1.7.19",
    "bullmq": "5.34.0",
    "compression": "1.8.0",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "ioredis": "5.4.1",
    "multer": "^2.5.0",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "tsx": "4.19.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/compression": "1.7.5",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.10.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "9.18.0",
    "prisma": "6.19.0",
    "supertest": "^7.3.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
