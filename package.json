{
  "name": "commercial-attention-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma Integral de Atencion Comercial - Foundation (F0)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:architecture": "node tests/architecture/run.js",
    "build": "npm run build --workspaces --if-present",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run test:architecture && npm run build",
    "db:migrate": "npm --workspace apps/api run db:migrate",
    "db:seed": "npm --workspace apps/api run db:seed"
  },
  "engines": {
    "node": ">=20"
  }
}
